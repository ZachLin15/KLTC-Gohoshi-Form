PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password

# Database — pick ONE of the following:
#
# 1) Local file (default if left unset) — nothing to configure, good for
#    local dev or any self-hosted deploy with a real persistent disk:
# DB_URL=file:./data.sqlite
#
# 2) Free hosted Turso database (needed for free-tier hosts like Render's
#    free web service, which has no persistent disk of its own). Create a
#    free database at https://turso.tech, then:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token

# Optional: path to python3 if not on PATH (used for PDF parsing)
# PYTHON_BIN=/usr/bin/python3
